# Proxy público do DocQC.
#   DOCQC_SITE  → https://192.168.1.20 (fase IP: o Caddy usa a sua CA interna para IPs)
#                 docqc.underall.com   (fase domínio: certificado Let's Encrypt automático)
#   SUPABASE_UPSTREAM → máquina do Supabase, ex. 192.168.1.10:8100
#
# A app e as APIs do Supabase ficam no mesmo endereço: o navegador nunca fala diretamente
# com a máquina do Supabase e o painel (Studio) não fica exposto.
{
	email {$ACME_EMAIL}
	# Acesso por IP: o navegador não envia SNI e, dentro do Docker, o IP local é o do
	# contentor, por isso o Caddy não saberia que certificado apresentar sem isto.
	default_sni {$DOCQC_DEFAULT_SNI:docqc.underall.com}
	# Porta dos redirecionamentos HTTP→HTTPS. Fora do Docker, numa máquina onde o nginx já
	# ocupa a 80, use outra (ex. 8088) e ponha a porta HTTPS em DOCQC_SITE (https://IP:8443).
	http_port {$DOCQC_CADDY_HTTP_PORT:80}
}

{$DOCQC_SITE} {
	encode zstd gzip

	@supabase path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/* /graphql/v1/*
	handle @supabase {
		reverse_proxy {$SUPABASE_UPSTREAM}
	}

	handle {
		# web:3000 no Docker; 127.0.0.1:<porta> quando a app corre com PM2 (deploy/web/pm2/).
		reverse_proxy {$DOCQC_APP_UPSTREAM:web:3000}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
