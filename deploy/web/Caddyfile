# Proxy público do DocQC.
#   DOCQC_SITE  → https://192.168.1.20 (fase IP: o Caddy usa a sua CA interna para IPs)
#                 docqc.underall.com   (fase domínio: certificado Let's Encrypt automático)
#   SUPABASE_UPSTREAM → máquina do Supabase, ex. 192.168.1.10:8100
#
# A app e as APIs do Supabase ficam no mesmo endereço: o navegador nunca fala diretamente
# com a máquina do Supabase e o painel (Studio) não fica exposto.
{
	email {$ACME_EMAIL}
}

{$DOCQC_SITE} {
	encode zstd gzip

	@supabase path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/* /functions/v1/* /graphql/v1/*
	handle @supabase {
		reverse_proxy {$SUPABASE_UPSTREAM}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
}
