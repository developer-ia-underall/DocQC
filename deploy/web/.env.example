# Copie para deploy/web/.env e preencha.

# Chave pública do Supabase do DocQC (o install.sh mostra-a no fim; também está em
# /opt/docqc-supabase/.env como SUPABASE_PUBLISHABLE_KEY). Nunca a SERVICE_ROLE/SECRET.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Máquina do Supabase e porta do gateway (install.sh --api-port, predefinição 8100).
SUPABASE_UPSTREAM=192.168.1.10:8100

# ── Fase 1: por IP (antes do DNS) ───────────────────────────────────────────────
# HTTPS com certificado da CA interna do Caddy: o navegador avisa uma vez, aceite.
# (HTTPS é necessário: o navegador só deixa calcular SHA-256 dos ficheiros em ligações seguras.)
DOCQC_SITE=https://192.168.1.20

# ── Fase 2: domínio (depois de docqc.underall.com apontar para esta máquina) ──
# DOCQC_SITE=docqc.underall.com
# ACME_EMAIL=admin@underall.com

# Portas no anfitrião (mude se 80/443 já estiverem ocupadas nesta máquina).
HTTP_PORT=80
HTTPS_PORT=443
